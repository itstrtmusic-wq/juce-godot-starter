extends SceneTree

func _initialize() -> void:
    var manifest: Dictionary = JUCE.get_api_manifest()
    assert(not manifest.complete_juce_wrapper)
    assert(manifest.version == "0.2.0")
    for cls in manifest.classes:
        assert(ClassDB.class_exists(cls.name), "Missing class: " + cls.name)
        var instance: Object = ClassDB.instantiate(cls.name)
        for method in cls.methods:
            assert(instance.has_method(method.name), "Missing method: " + cls.name + "." + method.name)
    assert(is_equal_approx(JUCE.decibels_to_gain(0.0), 1.0))
    assert(abs(JUCE.gain_to_decibels(0.5) + 6.0206) < 0.001)
    assert(is_equal_approx(JUCE.midi_note_to_hz(69), 440.0))

    var buffer := JuceAudioBuffer.new()
    assert(buffer.set_size(2, 4800))
    assert(not buffer.set_size(-1, 16))
    var samples := PackedFloat32Array()
    samples.resize(4800)
    for i in range(4800):
        samples[i] = 0.1 * sin(TAU * 440.0 * i / 48000.0)
    assert(buffer.set_channel(0, samples))
    assert(buffer.set_channel(1, samples))
    assert(buffer.get_rms_level(0) > 0.07)
    assert(not buffer.set_sample(9, 0, 1))
    var copy := buffer.duplicate_buffer()
    copy.apply_gain(0.5)
    assert(abs(copy.get_magnitude(0) - 0.05) < 0.001)
    assert(buffer.get_magnitude(0) > 0.09)

    var note := JuceMidiMessage.note_on(1, 60, 0.8)
    assert(note.is_note_on() and note.get_note_number() == 60)
    assert(JuceMidiMessage.note_on(0, 60, 0.8) == null)
    assert(JuceMidiMessage.from_bytes(PackedByteArray([0x90])) == null)
    assert(JuceMidiMessage.from_bytes(note.get_raw_data()).get_note_number() == 60)
    var midi := JuceMidiBuffer.new()
    assert(midi.add_event(note, 12))
    assert(midi.get_events()[0].sample_position == 12)
    assert(midi.get_num_events() == 1)
    var sequence := JuceMidiMessageSequence.new()
    assert(sequence.add_event(JuceMidiMessage.tempo_event(500000)))
    assert(sequence.add_event(note))
    var off := JuceMidiMessage.note_off(1, 60)
    off.set_timestamp(960.0)
    assert(sequence.add_event(off))
    var midi_file := JuceMidiFile.new()
    assert(midi_file.add_track(sequence))
    var prefix := "user://juce_api_test_%d_%d" % [OS.get_process_id(), Time.get_ticks_usec()]
    assert(midi_file.write_file(prefix + ".mid"))
    assert(not midi_file.write_file(prefix + ".mid"))
    var read_midi := JuceMidiFile.new()
    assert(read_midi.read_file(prefix + ".mid"))
    assert(read_midi.get_num_tracks() == 1)
    assert(read_midi.get_track(0).get_num_events() >= 3)
    read_midi.convert_timestamp_ticks_to_seconds()
    assert(abs(read_midi.get_track(0).get_end_time() - 0.5) < 0.001)

    var formats := JuceAudioFormatManager.new()
    assert(formats.write_wav(prefix + ".wav", buffer, 48000.0))
    assert(not formats.write_wav(prefix + ".wav", buffer, 48000.0))
    var decoded := formats.read_file(prefix + ".wav")
    assert(decoded.sample_rate == 48000.0)
    assert(decoded.buffer.get_num_samples() == 4800)
    assert(abs(decoded.buffer.get_sample(0, 20) - buffer.get_sample(0, 20)) < 0.00001)
    assert(formats.read_file(prefix + ".wav", 10).is_empty())
    var file := JuceFile.new()
    file.set_path(prefix + ".txt")
    assert(file.replace_with_text("JUCE from GDScript · 音 🎛"))
    assert(file.exists_as_file())
    assert(file.load_as_string() == "JUCE from GDScript · 音 🎛")

    var filter := JuceIIRFilter.new()
    assert(filter.make_low_pass(48000.0, 1000.0))
    assert(not filter.make_low_pass(48000.0, 40000.0))
    assert(filter.process(copy, 0))
    var reverb := JuceReverb.new()
    assert(reverb.set_parameters({"wet_level": 0.25, "dry_level": 0.75}))
    assert(not reverb.set_parameters({"wet_level": -1.0}))
    assert(reverb.process(copy))
    var adsr := JuceADSR.new()
    assert(adsr.set_sample_rate(48000.0))
    assert(adsr.set_parameters(0.01, 0.1, 0.8, 0.1))
    adsr.note_on()
    assert(adsr.apply_to_buffer(copy))
    var smoothing := JuceSmoothedValue.new()
    assert(smoothing.reset(48000, 0.005))
    smoothing.set_current_and_target_value(0.0)
    smoothing.set_target_value(1.0)
    assert(smoothing.is_smoothing())
    assert(is_equal_approx(smoothing.skip(240), 1.0))
    var random := JuceRandom.new()
    random.set_seed(42)
    var first := random.next_int(100000)
    random.set_seed(42)
    assert(random.next_int(100000) == first)

    var network := JuceDSPNetwork.new()
    assert(network.add_node("filter", "low_pass"))
    assert(network.add_node("drive", "tanh"))
    assert(network.add_node("echo", "delay"))
    assert(network.connect_nodes("input", "filter"))
    assert(network.connect_nodes("filter", "drive"))
    assert(network.connect_nodes("drive", "echo"))
    assert(network.connect_nodes("echo", "output"))
    assert(not network.connect_nodes("echo", "filter"))
    assert(network.set_parameter("filter", "frequency", 2000))
    assert(not network.set_parameter("filter", "typo", 2000))
    assert(network.get_nodes().size() == 5)
    assert(network.get_connections().size() == 4)
    assert(network.prepare(48000, 256, 2))
    assert(network.process(buffer))
    for value in buffer.get_channel(0):
        assert(is_finite(value))
    var device := JuceAudioDeviceManager.new()
    assert(device.set_network(network))
    assert(not device.start_audio("", -1.0, 256))
    assert(not network.is_active())
    device.stop_audio()
    device.stop_audio()
    if "--expect-no-device" in OS.get_cmdline_user_args():
        assert(not device.start_audio())
        assert(not network.is_active())
    for suffix in [".mid", ".wav", ".txt"]:
        DirAccess.remove_absolute(ProjectSettings.globalize_path(prefix + suffix))
    print("JUCE API: manifest, buffers, MIDI/WAV round trips, files, DSP, graph and device failure paths passed")
    quit(0)
