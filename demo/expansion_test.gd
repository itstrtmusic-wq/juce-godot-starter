extends SceneTree

func _initialize() -> void:
    var network := JuceDSPNetwork.new()
    assert(network.add_node("tone", "oscillator"))
    assert(network.add_node("filter", "low_pass"))
    assert(network.add_node("slow", "lfo"))
    assert(network.add_node("chorus", "chorus"))
    assert(network.add_node("phaser", "phaser"))
    assert(network.add_node("gate", "noise_gate"))
    assert(network.add_node("limiter", "limiter"))
    assert(network.connect_nodes("tone", "filter"))
    assert(network.connect_nodes("filter", "chorus"))
    assert(network.connect_nodes("chorus", "phaser"))
    assert(network.connect_nodes("phaser", "gate"))
    assert(network.connect_nodes("gate", "limiter"))
    assert(network.connect_nodes("limiter", "output"))
    assert(network.set_parameter("slow", "rate_hz", 2.0))
    assert(network.set_parameter("filter", "frequency", 2000.0))
    assert(network.connect_parameter("slow", "filter", "frequency", 1500.0))
    assert(network.get_modulation_connections().size() == 1)
    var buffer := JuceAudioBuffer.new()
    assert(buffer.set_size(2, 9600))
    assert(network.prepare(48000.0, 128, 2))
    assert(network.process(buffer))
    assert(network.get_parameters("filter").frequency == 2000.0)
    assert(abs(network.get_effective_parameters("filter").frequency - 2000.0) > 100.0)
    for value in buffer.get_channel(0):
        assert(is_finite(value) and abs(value) <= 1.0)

    var original := network.export_patch()
    var duplicate := JuceDSPNetwork.new()
    assert(duplicate.load_patch(original))
    assert(duplicate.export_patch() == original)
    var invalid := original.duplicate(true)
    invalid.nodes[0].parameters.typo = 1.0
    assert(not network.load_patch(invalid))
    assert(network.export_patch() == original)
    assert(network.process(buffer)) # Failed patch leaves the prepared graph usable.
    invalid = original.duplicate(true)
    invalid.modulations.append({"source": "filter", "destination": "slow", "parameter": "rate_hz", "depth": 1.0})
    assert(not network.load_patch(invalid))
    assert(network.export_patch() == original)
    invalid = original.duplicate(true)
    invalid.schema_version = 2
    assert(not network.load_patch(invalid))
    invalid = original.duplicate(true)
    invalid.modulations[0].channel = 0.5
    assert(not network.load_patch(invalid))
    assert(network.export_patch() == original)
    var prefix := "user://juce_patch_音_%d_%d" % [OS.get_process_id(), Time.get_ticks_usec()]
    var path := prefix + ".json"
    assert(network.save_patch(path))
    assert(not network.save_patch(path))
    assert(duplicate.load_patch_file(path))
    assert(duplicate.export_patch() == original)
    # JSON numbers are represented as doubles; integral schema/channel numbers must round-trip.
    assert(duplicate.load_patch(JSON.parse_string(JSON.stringify(original))))
    var missing := original.duplicate(true)
    missing.nodes[0].parameters["frequency"] = INF
    assert(not duplicate.load_patch(missing))
    assert(duplicate.export_patch() == original)
    assert(not duplicate.process(buffer))
    assert(duplicate.prepare(48000.0, 128, 2))
    assert(duplicate.process(buffer))
    var broken := JuceFile.new()
    broken.set_path(prefix + "_broken.json")
    assert(broken.replace_with_text("{ bad JSON"))
    assert(not duplicate.load_patch_file(prefix + "_broken.json"))
    assert(duplicate.export_patch() == original)

    for name in ["JuceChorus", "JucePhaser", "JuceCompressor", "JuceLimiter", "JuceNoiseGate"]:
        var effect: RefCounted = ClassDB.instantiate(name)
        assert(not effect.process(buffer))
        assert(not effect.get_last_error().is_empty())
        var defaults: Dictionary = effect.get_parameters()
        assert(effect.set_parameters(defaults))
        var invalid_settings := defaults.duplicate(true)
        invalid_settings[defaults.keys()[0]] = effect.get_parameter_info()[defaults.keys()[0]].max
        invalid_settings["typo"] = 1
        assert(not effect.set_parameters(invalid_settings))
        assert(not effect.set_parameters({"typo": 1}))
        assert(effect.get_parameters() == defaults)
        assert(not effect.set_parameters({defaults.keys()[0]: NAN}))
        assert(not effect.set_parameters({defaults.keys()[0]: true}))
        assert(not effect.prepare(48000.0, 0, 2))
        assert(effect.prepare(48000.0, 128, 2))
        assert(effect.process(buffer))
        assert(effect.reset())
        var info: Dictionary = effect.get_parameter_info()
        for key in info:
            # Boundary values returned from the float-backed API must be valid inputs again.
            assert(effect.set_parameters({key: info[key].max}))
            assert(effect.set_parameters(effect.get_parameters()))
        assert(effect.process(buffer))
        for value in buffer.get_channel(0):
            assert(is_finite(value))
    var compressor := JuceCompressor.new()
    assert(compressor.set_parameters({"threshold_db": -18.0, "ratio": 4.0}))
    assert(compressor.prepare(48000.0, 128, 2))
    var loud := JuceAudioBuffer.new()
    assert(loud.set_size(2, 24000))
    var ones := PackedFloat32Array()
    ones.resize(24000)
    ones.fill(1.0)
    assert(loud.set_channel(0, ones) and loud.set_channel(1, ones))
    assert(compressor.process(loud))
    assert(loud.get_sample(0, 23999) > 0.1 and loud.get_sample(0, 23999) < 0.4)
    var limiter := JuceLimiter.new()
    assert(limiter.prepare(48000.0, 128, 2))
    loud.apply_gain(100.0)
    assert(limiter.process(loud))
    assert(loud.get_magnitude(0) <= 1.0)
    for suffix in [".json", "_broken.json"]:
        DirAccess.remove_absolute(ProjectSettings.globalize_path(prefix + suffix))
    print("JUCE expansion: native effects, modulation, patch transactions, JSON round trips and validation passed")
    quit(0)
